      "input": {"localHistory": [{"id": "local", "timerId": "local-timer", "status": "completed"}], "remoteHistory": [{"id": "remote", "timerId": "remote-timer", "status": "completed"}], "hasLocalState": false, "hasRemoteState": true},
      "expected": {"mode": "choose", "localHistoryCount": 1, "remoteHistoryCount": 1},
      "desktop": {"returned": null}
    },
    {
      "name": "both_history_and_both_state",
      "input": {"localHistory": [{"id": "local", "timerId": "local-timer", "status": "completed"}], "remoteHistory": [{"id": "remote", "timerId": "remote-timer", "status": "completed"}], "hasLocalState": true, "hasRemoteState": true},
      "expected": {"mode": "choose", "localHistoryCount": 1, "remoteHistoryCount": 1},
      "desktop": {"returned": null}
    },
    {
      "name": "both_state_with_noncompleted_history",
      "input": {"localHistory": [{"id": "local", "status": "cancelled"}], "remoteHistory": [{"id": "remote", "status": "superseded"}], "hasLocalState": true, "hasRemoteState": true},
      "expected": {"mode": "auto", "strategy": "merge", "reason": "local_state_only"},
      "desktop": {"returned": "merge"}
