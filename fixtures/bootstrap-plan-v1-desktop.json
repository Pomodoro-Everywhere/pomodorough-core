      "expected": {"mode": "auto", "strategy": "keep_remote", "reason": "empty"},
      "desktop": {"returned": "keep_remote"}
    },
    {
      "name": "empty_explicit",
      "input": {"localHistory": [], "remoteHistory": [], "hasLocalState": false, "hasRemoteState": false},
