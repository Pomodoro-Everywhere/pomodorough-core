      "expected": {"mode": "auto", "strategy": "replace_remote", "reason": "local_only"},
      "desktop": {"returned": "replace_remote"}
    },
    {
      "name": "local_history_and_remote_state",
      "input": {"localHistory": [{"id": "local", "timerId": "local-timer", "status": "completed"}], "remoteHistory": [], "hasLocalState": false, "hasRemoteState": true},
      "expected": {"mode": "choose", "localHistoryCount": 1, "remoteHistoryCount": 0},
      "desktop": {"returned": null}
    },
    {
      "name": "local_history_and_both_state",
      "input": {"localHistory": [{"id": "local", "timerId": "local-timer", "status": "completed"}], "remoteHistory": [], "hasLocalState": true, "hasRemoteState": true},
