    {
      "name": "completed_history_identity_counts",
      "input": {
        "localHistory": [{"id": "local-a", "timerId": "timer-a", "status": "completed"}, {"id": "local-b", "timerId": "timer-a", "status": "completed"}, {"id": "fallback", "timerId": "", "status": "completed"}, {"id": "fallback", "status": "completed"}, {"id": "ignored", "status": "cancelled"}, {"status": "completed"}],
        "remoteHistory": [{"id": "remote", "status": "completed"}],
        "hasLocalState": false, "hasRemoteState": false
      },
      "expected": {"mode": "choose", "localHistoryCount": 2, "remoteHistoryCount": 1},
      "desktop": {"returned": null}
