    {
      "name": "remote_state_with_noncompleted_history",
      "input": {"localHistory": [], "remoteHistory": [{"id": "remote", "status": "cancelled"}], "hasLocalState": false, "hasRemoteState": true},
      "expected": {"mode": "auto", "strategy": "keep_remote", "reason": "empty"},
      "desktop": {"returned": "keep_remote"}
